# -- Application -------------------------------------------------------
PROJECT_NAME="BWIN Consultants API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# -- API ---------------------------------------------------------------
API_V1_PREFIX="/api/v1"

# -- Server ------------------------------------------------------------
HOST="127.0.0.1"
PORT=8000

# -- Security ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# The application refuses to boot in production while this is the default, or
# if it is shorter than 32 bytes - HS256 signs every token with it.
SECRET_KEY="change-me-in-production-with-a-generated-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# -- Database ----------------------------------------------------------
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="bwindb"
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

# -- Redis -------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# -- CORS - JSON array of allowed origins ------------------------------
CORS_ORIGINS='["http://localhost:3000"]'

# -- Pagination --------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# -- Storage -----------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
